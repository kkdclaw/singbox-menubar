<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Демон sing-box. Заменить USERNAME на своё имя пользователя (whoami),
     положить в /Library/LaunchDaemons/com.kkd.singbox.plist, владелец root:wheel, права 644. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kkd.singbox</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/sing-box</string>
		<string>run</string>
		<string>-c</string>
		<string>/Users/USERNAME/.config/sing-box/config.json</string>
		<string>-D</string>
		<string>/Users/USERNAME/.local/share/sing-box</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/USERNAME/.local/share/sing-box/sing-box.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/USERNAME/.local/share/sing-box/sing-box.log</string>
</dict>
</plist>
